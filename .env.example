# Names only, never a value. Copy this file to .env and type the values there.
# .env is ignored by git; secrets live in the provider dashboards and the local .env only.
# Each task adds the names its code reads.

# The address of the PostgreSQL database. README.md, "Run it", shows the local one in full:
# the local database has no password, so that address is no secret.
DATABASE_URL=
