# Names only, never a value. Copy this file to .env and type the values there.
# .env is ignored by git; secrets live in the provider dashboards and the local .env only.
# Each task adds the names its code reads.

# The address of the PostgreSQL database. README.md, "Run it", shows the local one in full:
# the local database has no password, so that address is no secret.
DATABASE_URL=

# The CA certificate of the database on DigitalOcean. Empty on this machine and in CI; on the
# test copy DigitalOcean binds it itself (docs/deploy.md).
DATABASE_CA_CERT=

# The commit the app runs, shown by /health and the start page. Empty here: "unknown".
GIT_COMMIT=

# Signs the session cookie (task 0.6). Empty on this machine and in CI: outside production the
# login library's public development value is used. On the test copy the owner types it in the
# DigitalOcean dashboard (docs/deploy.md).
BETTER_AUTH_SECRET=

# The file storage, S3 API (task 0.12): SeaweedFS of docker-compose.yml on this machine, Cloudflare
# R2 on the test copy and in production. README.md, "Run it", shows the local values in full: the
# local keys are invented and open nothing elsewhere. R2's keys are typed by the owner in the
# DigitalOcean dashboard (task 0.15). Tests and CI need none of them.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
