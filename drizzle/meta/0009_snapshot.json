        },
        "settings_price_hint_percent_check": {
          "name": "settings_price_hint_percent_check",
          "value": "key <> 'price_hint_percent' OR (CASE WHEN jsonb_typeof(value) IS DISTINCT FROM 'number' THEN false WHEN (value)::numeric <> trunc((value)::numeric) THEN false ELSE (value)::numeric BETWEEN 0 AND 1000 END)"
        },
        "settings_overspend_guard_percent_check": {
          "name": "settings_overspend_guard_percent_check",
          "value": "key <> 'overspend_guard_percent' OR (CASE WHEN jsonb_typeof(value) = 'string' THEN value = '\"off\"'::jsonb ELSE CASE WHEN jsonb_typeof(value) IS DISTINCT FROM 'number' THEN false WHEN (value)::numeric <> trunc((value)::numeric) THEN false ELSE (value)::numeric BETWEEN 0 AND 1000 END END)"
        },
        "settings_reminder_hours_check": {
          "name": "settings_reminder_hours_check",
          "value": "key <> 'reminder_hours' OR (CASE WHEN jsonb_typeof(value) IS DISTINCT FROM 'number' THEN false WHEN (value)::numeric <> trunc((value)::numeric) THEN false ELSE (value)::numeric BETWEEN 1 AND 720 END)"
        },
        "settings_escalation_hours_check": {
          "name": "settings_escalation_hours_check",
          "value": "key <> 'escalation_hours' OR (CASE WHEN jsonb_typeof(value) IS DISTINCT FROM 'number' THEN false WHEN (value)::numeric <> trunc((value)::numeric) THEN false ELSE (value)::numeric BETWEEN 1 AND 720 END)"
        },
        "settings_receipt_required_for_cash_check": {
          "name": "settings_receipt_required_for_cash_check",
          "value": "key <> 'receipt_required_for_cash' OR (jsonb_typeof(value) = 'boolean')"
        },
        "settings_school_name_check": {
          "name": "settings_school_name_check",
          "value": "key <> 'school_name' OR (CASE WHEN jsonb_typeof(value) IS DISTINCT FROM 'string' THEN false WHEN (value #>> '{}') ~ '^[[:space:]]|[[:space:]]$' THEN false ELSE char_length(value #>> '{}') BETWEEN 1 AND 120 END)"
        },
        "settings_school_year_start_check": {
          "name": "settings_school_year_start_check",
          "value": "key <> 'school_year_start' OR (CASE WHEN jsonb_typeof(value) IS DISTINCT FROM 'object' THEN false WHEN value - 'month' - 'day' <> '{}'::jsonb THEN false WHEN NOT CASE WHEN jsonb_typeof(value -> 'month') IS DISTINCT FROM 'number' THEN false WHEN (value -> 'month')::numeric <> trunc((value -> 'month')::numeric) THEN false ELSE (value -> 'month')::numeric BETWEEN 1 AND 12 END THEN false WHEN NOT CASE WHEN jsonb_typeof(value -> 'day') IS DISTINCT FROM 'number' THEN false WHEN (value -> 'day')::numeric <> trunc((value -> 'day')::numeric) THEN false ELSE (value -> 'day')::numeric BETWEEN 1 AND 31 END THEN false ELSE (value ->> 'day')::int <= CASE (value ->> 'month')::int WHEN 2 THEN 28 WHEN 4 THEN 30 WHEN 6 THEN 30 WHEN 9 THEN 30 WHEN 11 THEN 30 ELSE 31 END END)"
        }
      },
      "isRLSEnabled": false
    },
